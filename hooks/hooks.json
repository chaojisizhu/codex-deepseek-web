{
  "description": "DeepSeek web tools for DeepSeek models. GPT-series (OpenAI) models are told at session start not to use them and are denied if they call anyway; other model families pass through.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_notice.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/session_notice.py\"",
            "timeout": 10,
            "statusMessage": "Noting DeepSeek-only tools for GPT-series models"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__ds_web.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/model_gate.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/model_gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking GPT-series gate for DeepSeek web tools"
          }
        ]
      }
    ]
  }
}
