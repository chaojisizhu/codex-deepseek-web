{
  "description": "DeepSeek-only web tools: tell non-DeepSeek models at session start not to use them, and deny any call that still reaches for them.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_notice.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/session_notice.py\"",
            "timeout": 10,
            "statusMessage": "Noting DeepSeek-only tools for this model"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__ds_web.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/model_gate.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/model_gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking model access to DeepSeek web tools"
          }
        ]
      }
    ]
  }
}
